<root>
	<styles>
		<include src="file://{resources}/styles/custom_game/rpg_hud.css" />
	</styles>
	<scripts>
		<include src="file://{resources}/scripts/custom_game/rpg_hud.js" />
	</scripts>
	<Panel class="RpgRoot" hittest="false">
		<Panel id="WaveBox" class="Hidden" hittest="false">
			<Panel id="WaveHeader" hittest="false">
				<Label id="WaveCaption" text="ВОЛНА" />
				<Label id="WaveNum" text="1" />
				<Label id="WaveFinal" text="/ 100" />
				<Label id="WaveTag" class="Hidden" text="" />
			</Panel>
			<Label id="WaveInfo" text="" />
			<Panel id="BarBg" hittest="false"><Panel id="BarFill" hittest="false" /></Panel>
			<Panel id="GameBarBg" hittest="false"><Panel id="GameBarFill" hittest="false" /></Panel>
			<Panel id="WaveFooter" hittest="false">
				<Label id="LivesCaption" text="ЖИЗНИ" />
				<Panel id="LivesRow" hittest="false" />
				<Label id="NextBoss" text="" />
			</Panel>
			<Button id="NextWaveButton" class="Hidden" onactivate="NextWave()"><Label text="Следующий раунд" /></Button>
		</Panel>

		<Panel id="HeroSidebar" hittest="true">
			<Panel id="HeroHeader">
				<Panel id="HeroPortrait" />
				<Panel id="HeroMeta">
					<Label id="HeroName" text="ГЕРОЙ" />
					<Label id="HeroClass" text="АРЕНА" />
					<Label id="HeroLevel" text="УРОВЕНЬ 1" />
				</Panel>
			</Panel>
			<Panel id="SidebarTabs">
				<Button id="TabStats" class="TabBtn active" onactivate="ActivateSidebarTab('stats')"><Label text="Статы" /></Button>
				<Button id="TabTalents" class="TabBtn" onactivate="ActivateSidebarTab('talents')"><Label text="Таланты" /></Button>
				<Button id="TabPerks" class="TabBtn" onactivate="ActivateSidebarTab('perks')"><Label text="Перки" /></Button>
				<Button id="TabGear" class="TabBtn" onactivate="ActivateSidebarTab('gear')"><Label text="Снаряжение" /></Button>
			</Panel>

			<Panel id="HeroPanels">
				<Panel id="StatsPanel" class="SidebarPanel active">
					<Label class="SectionTitle" text="БОЕВОЙ ПРОФИЛЬ" />
					<Panel id="StatGrid">
						<Panel class="StatCard"><Label class="StatName" text="УРОН АТАКИ" /><Panel class="StatBar"><Panel id="DamageFill" class="StatFill damage" /></Panel><Label id="DamageValue" class="StatValue" text="0" /></Panel>
						<Panel class="StatCard"><Label class="StatName" text="СКОРОСТЬ ПЕРЕДВИЖЕНИЯ" /><Panel class="StatBar"><Panel id="MoveFill" class="StatFill speed" /></Panel><Label id="MoveValue" class="StatValue" text="0" /></Panel>
						<Panel class="StatCard"><Label class="StatName" text="СКОРОСТЬ АТАКИ" /><Panel class="StatBar"><Panel id="AttackFill" class="StatFill attack" /></Panel><Label id="AttackValue" class="StatValue" text="0" /></Panel>
						<Panel class="StatCard"><Label class="StatName" text="ЗДОРОВЬЕ" /><Panel class="StatBar"><Panel id="HealthFill" class="StatFill hp" /></Panel><Label id="HealthValue" class="StatValue" text="0 / 0" /></Panel>
					</Panel>
					<Label id="BonusSummary" class="BonusSummary" text="Бонусы: загрузка..." />
				</Panel>

				<Panel id="TalentPanel" class="SidebarPanel">
					<Label class="SectionTitle" text="ТАЛАНТЫ ГЕРОЯ" />
					<Panel id="TalentScroll"><Panel id="TalentCards" /></Panel>
					<Label id="PointsLabel" text="Очки атрибутов: 0" />
					<Panel class="StatRow">
						<Button class="StatBtn" onactivate="Spend('str')"><Label id="StrLabel" text="СИЛА +0" /></Button>
						<Button class="StatBtn" onactivate="Spend('agi')"><Label id="AgiLabel" text="ЛОВКОСТЬ +0" /></Button>
						<Button class="StatBtn" onactivate="Spend('int')"><Label id="IntLabel" text="ИНТЕЛЛЕКТ +0" /></Button>
					</Panel>
				</Panel>

				<Panel id="PerkPanel" class="SidebarPanel">
					<Label class="SectionTitle" text="ВАШИ ПЕРКИ" />
					<Label id="PerkPath" class="PerkPath" text="Мифический путь ещё не выбран" />
					<Panel id="PerkSummaryList" class="PerkSummaryList" />
				</Panel>

				<Panel id="GearPanel" class="SidebarPanel">
					<Label class="SectionTitle" text="СНАРЯЖЕНИЕ" />
					<Panel id="GearList" hittest="false" />
					<Label id="TotalsTitle" text="АКТИВНЫЕ БОНУСЫ" />
					<Panel id="TotalsList" hittest="false" />
				</Panel>
			</Panel>
		</Panel>

		<Panel id="QuickPanel" hittest="true">
			<Label id="QuickTitle" text="БОЕВАЯ СВОДКА" />
			<Panel id="QuickStats">
				<Panel class="QuickMetric"><Label class="QuickMetricLabel" text="ВОЛНА" /><Label id="QuickWave" class="QuickMetricValue" text="0" /></Panel>
				<Panel class="QuickMetric"><Label class="QuickMetricLabel" text="БОСС" /><Label id="QuickBoss" class="QuickMetricValue" text="—" /></Panel>
				<Panel class="QuickMetric"><Label class="QuickMetricLabel" text="ВРАГИ" /><Label id="QuickKills" class="QuickMetricValue" text="0" /></Panel>
			</Panel>
		</Panel>

		<Panel id="PerkBox" class="Hidden" hittest="true">
			<Label id="PerkTitle" text="Выберите улучшение" />
			<Panel id="PerkCards" />
		</Panel>
		<Panel id="ToastBox" hittest="false" />
	</Panel>
</root>
